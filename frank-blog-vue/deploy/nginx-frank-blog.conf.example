server {
    listen 80;
    listen [::]:80;

    # 改成你的服务器公网 IP 或域名，例如：
    # server_name 123.45.67.89;
    # server_name blog.example.com;
    server_name YOUR_SERVER_IP_OR_DOMAIN;

    root /var/www/frank-blog;
    index index.html;

    # Vue Router 使用 history 模式。
    # 这一行非常重要，否则直接刷新 /profile、/drafts、/article/xxx 会出现 404。
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite 构建出的带 hash 资源可以长期缓存。
    location /assets/build/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 目前项目中的日系插画、EasyMDE、KaTeX 等静态资源。
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    # 后面写 Java/SSM 后端时，可以打开类似下面的代理配置：
    # location /api/ {
    #     proxy_pass http://127.0.0.1:8080/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
}
