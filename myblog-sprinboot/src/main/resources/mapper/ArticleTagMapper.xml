<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.txf.myblogsprinboot.dao.ArticleTagMapper">
    <insert id = "batchInsertArticleTag">
        insert into blog_article_tag(article_id, tag_id, sort_order)
        values
        <foreach collection="articleTagList" item = "at" separator=",">
            (#{at.articleId},  #{at.tagId}, #{at.sortOrder})
        </foreach>
    </insert>
</mapper>