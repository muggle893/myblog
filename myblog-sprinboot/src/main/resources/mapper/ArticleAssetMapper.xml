<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.txf.myblogsprinboot.dao.ArticleAssetMapper">
    <insert id = "batchInsertArticleAsset">
        insert into blog_article_asset(article_id, asset_id, usage_type)
        values
        <foreach collection="articleAssets" item = "articleAsset" separator=",">
            (#{articleAsset.articleId},  #{articleAsset.assetId}, #{articleAsset.usageType})
        </foreach>
    </insert>
</mapper>