<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.txf.myblogsprinboot.dao.UserMapper">
    <sql id = "userTableField">
        `id`, `username`, password_hash, email, phone, role_code, status, last_login_at,
            created_at, updated_at
    </sql>
    <select id="selectUserByUsername" resultType="org.txf.myblogsprinboot.model.User">
        select <include refid="userTableField"></include>
        from blog_user
        where username = #{username};
    </select>

    <select id="selectUserByUserId" resultType="org.txf.myblogsprinboot.model.User">
        select <include refid="userTableField"></include>
        from blog_user
        where id = #{id};
    </select>
</mapper>


