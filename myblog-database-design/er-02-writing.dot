digraph ER {
graph [rankdir=TB, bgcolor="#F5F8FC", pad="0.45", nodesep="0.65", ranksep="0.95", splines=polyline, fontname="DejaVu Sans", fontsize=22, labelloc=t, label="02 / ARTICLES, DRAFTS AND TAGS\nMyBlog | MySQL 8.0.16+ | Schema v1.0"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=9, color="#899BAF", fontcolor="#536879", arrowsize=0.6, arrowhead=none, labeldistance=2.5];
blog_user [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#315E86"><FONT COLOR="white" POINT-SIZE="13"><B>blog_user</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#536879" POINT-SIZE="10">Account</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">role_code</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">TINYINT</FONT></TD></TR></TABLE>>];
blog_category [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#70559A"><FONT COLOR="white" POINT-SIZE="13"><B>blog_category</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#536879" POINT-SIZE="10">Categories</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">SMALLINT</FONT></TD></TR></TABLE>>];
blog_tag [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#70559A"><FONT COLOR="white" POINT-SIZE="13"><B>blog_tag</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#536879" POINT-SIZE="10">Article tags</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">VARCHAR(20)</FONT></TD></TR></TABLE>>];
blog_article [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#70559A"><FONT COLOR="white" POINT-SIZE="13"><B>blog_article</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#536879" POINT-SIZE="10">Published articles</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083">FK</FONT></TD><TD ALIGN="LEFT">author_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083">FK</FONT></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">content_markdown</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">MEDIUMTEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">visibility</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">published_at</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">DATETIME(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#537083"> </FONT></TD><TD ALIGN="LEFT">row_version</TD><TD ALIGN="LEFT"><FONT COLOR="#718296">INT</FONT></TD></TR></TABLE>>];
